# harnesys docker compose — copy to deploy/.env and adjust.
#
# Token note: there is deliberately no HOST_TOKEN here. The host generates
# `host.token` in /data/config.json on first boot and the web gate reads it
# from the shared volume automatically. Read it with:
#   docker compose exec host cat /data/config.json

# Host-side published port for the host API (the container always listens on 3000).
PORT=3000

# Host-side published port for the web UI (the container always listens on 8080).
WEB_PORT=8080

# Public origin used by the host for webhook URLs, e.g. https://harnesys.example.com
# Leave unset to omit it from the generated config.
#PUBLIC_URL=

# Upstream the web proxy forwards /api and /ws to.
# Default is the compose `host` service on its fixed container port.
#UPSTREAM=http://host:3000
