{
  "name": "harnesys",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:server": "bun run --cwd apps/server dev",
    "dev:webui": "bun run --cwd apps/webui dev",
    "dev:desktop": "bun run scripts/dev-desktop.ts",
    "build:host": "bun build --compile apps/server/src/index.ts --outfile build/harnesys-host && rm -rf build/assets && cp -R apps/server/assets build/assets",
    "build:web": "bun build --compile apps/webui/server/index.ts --outfile build/harnesys-web",
    "build:cli": "bun build --compile apps/cli/src/index.ts --outfile build/harnesys",
    "build:client": "bun run --cwd apps/webui build",
    "build:desktop": "bun run scripts/build-desktop.ts",
    "release": "bun run scripts/release.ts",
    "icon:desktop": "bun run icon:desktop:tauri && bun run icon:desktop:app && bun run icon:desktop:macos",
    "icon:desktop:tauri": "bun run --cwd apps/desktop tauri icon src-tauri/icons/app-icon.svg",
    "icon:desktop:app": "swift apps/desktop/src-tauri/icons/render-app-icon.swift apps/desktop/src-tauri/icons/icon.png apps/desktop/src-tauri/icons/app-icon.png",
    "icon:desktop:macos": "bash scripts/icons-macos.sh",
    "db:generate": "bun run --cwd apps/server db:generate",
    "db:migrate": "bun run --cwd apps/server db:migrate",
    "db:studio": "bun run --cwd apps/server db:studio",
    "docs:merge": "bun run scripts/docs-merge.ts",
    "vendor:plugin-schemas": "bun run scripts/vendor-plugin-schemas.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write --unsafe .",
    "typecheck": "bun run --cwd packages/harnesys typecheck && bun run --cwd packages/studio-shared typecheck && bun run --cwd apps/server typecheck && bun run --cwd apps/webui typecheck && bun run --cwd apps/cli typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
