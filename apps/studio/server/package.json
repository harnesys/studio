{
  "name": "@harnesys/studio-server",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "bun --watch index.ts",
    "start": "NODE_ENV=production bun index.ts",
    "typecheck": "bunx tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@harnesys/studio-shared": "workspace:*",
    "croner": "^10.0.1",
    "drizzle-orm": "^0.45.2",
    "harnesys": "workspace:*",
    "hono": "^4.13.2",
    "ignore": "^7.0.6",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "drizzle-kit": "^0.31.10"
  }
}
