    "@iconify/react": "^6.0.2",
    "@monaco-editor/react": "^4.7.0",
    "@shadcn/react": "^0.3.0",
    "@tanstack/react-query": "^5.90.2",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "croner": "^10.0.1",
    "drizzle-orm": "^0.45.2",
    "harnesys": "workspace:*",
    "highlight.js": "^11.12.0",
    "hono": "^4.13.2",
    "ignore": "^7.0.6",
    "katex": "^0.18.4",
    "lucide-react": "^1.31.0",
    "mermaid": "^11.17.0",
