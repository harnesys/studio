# Studio API (Bun / Hono)
PORT=3000

# Vite dev server
VITE_DEV_SERVER_PORT=5173

SERVER_TRACE=false
CLIENT_TRACE=false

# Path overrides (defaults usually suffice)
# Host home for skills/presets overrides, DB, workspaces: default ~/.harnesys
# HARNESYS_HOME=/absolute/path
# Shipped skills/presets root: default apps/studio/assets/skills
# HARNESYS_BUNDLED_SKILLS=/absolute/path

