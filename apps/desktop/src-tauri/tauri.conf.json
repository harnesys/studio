{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Harnesys",
  "version": "0.1.27",
  "identifier": "com.mikestotik.harnesys",
  "build": {
    "beforeDevCommand": "bun run --cwd ../webui dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run --cwd ../webui build",
    "frontendDist": "../../webui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Harnesys",
        "width": 1280,
        "height": 800,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "appimage",
      "deb"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/harnesys-host"
    ],
    "resources": {
      "../../server/assets": "assets"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUxNUVDQTEwMEIwMzVFRDIKUldUU1hnTUxFTXBlNGV3bmlLWEVGSk9iaCtKa2VncEZVZWVDeExZQ2E5bUhPOEdhZTNVaDJ4OCsK",
      "endpoints": [
        "https://github.com/harnesys/studio/releases/latest/download/latest.json"
      ]
    }
  }
}
