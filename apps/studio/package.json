{
  "name": "@harnesys/studio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run dev.ts",
    "dev:server": "bun --watch server/index.ts",
    "dev:ui": "vite --config client/vite.config.ts",
    "build": "vite build --config client/vite.config.ts",
    "start": "NODE_ENV=production bun server/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "typecheck": "bunx tsc -p tsconfig.json --noEmit && bunx tsc -p client/tsconfig.app.json --noEmit"
  },
