{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Harnesys",
  "version": "0.1.6",
  "identifier": "com.mikestotik.harnesys",
  "build": {
    "beforeDevCommand": "bun run --cwd ../webui dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run --cwd ../webui build",
    "frontendDist": "../../webui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Harnesys",
        "width": 1280,
        "height": 800,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/harnesys-host"
    ],
    "resources": {
      "../../server/assets/**/*": "assets/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
